# Copy to backend/.env and fill in. The .env file is git-ignored: never commit keys.

# live = call the real models, mock = canned sample content (no keys needed)
EXECUTION_MODE=live

# ---- Claude Sonnet 5.5: the script text (outline, every card, reviews, repairs, chat assist) and the HTML animations
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Gemini Flash: Mermaid flow diagrams (text model) and pictures (image model)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_IMAGE_ASPECT=16:9
# Set when exports (markdown, HackMD) must carry absolute picture links, for example https://scripts.scaler.com
PUBLIC_BASE_URL=

# How long a call keeps retrying a rate limit or an overload before it reports the problem (seconds)
LLM_MAX_WAIT_SECONDS=120
# Spending limit in dollars for Claude/OpenRouter calls, all time. 0 turns it off.
LLM_BUDGET_USD=15

# Mock content is never used silently. Set to 1 only to allow sample content when a model is down.
ALLOW_MOCK_FALLBACK=0

# HackMD sharing (optional)
HACKMD_API_TOKEN=

# Picture visuals (Wikimedia search, Gemini images). 0 = off: planned images become flow diagrams. 1 = on.
IMAGES_ENABLED=0

# ---- Sign-in with Google (for a deployed copy). Leave AUTH_MODE unset locally to keep the simple email sign-in.
# AUTH_MODE=google
# Firebase web settings (public values, from Firebase console: Project settings, Your apps)
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# FIREBASE_PROJECT_ID=your-project
# FIREBASE_APP_ID=
# SESSION_SECRET=              # at least 16 random characters, for example the output of: python3 -c "import secrets; print(secrets.token_hex(32))"
# ADMIN_EMAILS=admin@scaler.com   # these people become administrators on their first sign-in (comma separated)
# ALLOWED_EMAIL_DOMAIN=scaler.com
# CORS_ORIGINS=                # optional: websites allowed to call the API (comma separated)

# ---- Where the database file lives. Default: backend/scripts.db. On a host that wipes its disk on every deploy (Render, Railway) attach a persistent disk
# and point this at it, for example /var/data/scripts.db
# DATABASE_PATH=
